@startuml EuroCRM Capital Markets Data Model

title Knight Frank EuroCRM — Capital Markets Data Model Schema

'skinparam backgroundColor #FEFEFE
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0

' ===== Origination & Agreement =====
rectangle "Origination & Agreement" as ORIG {
  class "kf_Deal" as DEAL {
    kf_dealid : GUID ++
    --
    kf_name : Text
    kf_dealreference : Text
    kf_dealstatus : OptionSet
    kf_bpfstage : OptionSet (S1-S8)
    kf_dealdirection : OptionSet (Buy/Sell)
    --
    kf_accountid : Lookup → Account
    kf_contactid : Lookup → Contact
    kf_legalentityaccountid : Lookup → Account
    kf_propertyid : Lookup → kf_Property
    --
    kf_mandatedate : Date
    kf_targetcompletiondate : Date
    kf_actualcompletiondate : Date
    kf_grossfeevalue : Currency
    kf_netfeevalue : Currency
    --
    owningbusinessunit : Lookup → BU
    createdon : DateTime
    modifiedon : DateTime
  }

  class "kf_Pitch" as PITCH {
    kf_pitchid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_pitchdate : Date
    kf_pitchstatus : OptionSet
    kf_winlossreason : Text
    --
    createdon : DateTime
  }

  class "kf_NDA" as NDA {
    kf_ndaid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_accountid : Lookup → Account
    kf_contactid : Lookup → Contact
    kf_ndadate : Date
    kf_expirydate : Date
    kf_status : OptionSet
    --
    createdon : DateTime
  }
}

' ===== Bidding & Due Diligence =====
rectangle "Bidding & Due Diligence" as BIDDING {
  class "kf_Bid" as BID {
    kf_bidid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_investoraccountid : Lookup → Account
    kf_investorcontactid : Lookup → Contact
    kf_investorprofileid : Lookup → kf_InvestorProfile
    --
    kf_bidround : Integer
    kf_biddate : Date
    kf_bidamount : Currency
    kf_bidstatus : OptionSet
    kf_bidprice_psm : Currency
    --
    createdon : DateTime
  }

  class "kf_DDMilestone" as DD {
    kf_ddmilestoneid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_milestonetype : OptionSet
    kfduedate : Date
    kf_completeddate : Date
    kf_status : OptionSet
    kf_ownerid : Text
    --
    createdon : DateTime
  }

  class "kf_RedFlag" as REDFLAG {
    kf_redflagid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_flagtype : OptionSet
    kf_description : Text
    kf_severity : OptionSet
    kf_status : OptionSet
    kf resolutiondate : Date
    --
    createdon : DateTime
  }
}

' ===== Compliance & Investors =====
rectangle "Compliance & Investors" as COMPLY {
  class "kf_KYCRecord" as KYC {
    kf_kycrecordid : GUID ++
    --
    kf_accountid : Lookup → Account
    kf_dealid : Lookup → kf_Deal
    kf_kycstatus : OptionSet
    kf_checkdate : Date
    kf_expirydate : Date
    kf_jurisdiction : OptionSet
    --
    createdon : DateTime
  }

  class "kf_InvestorProfile" as PROFILE {
    kf_investorprofileid : GUID ++
    --
    kf_accountid : Lookup → Account
    kf_strategy : OptionSet
    kf_targetsectors : MultiSelect
    kf_targetgeographies : MultiSelect
    kf_ticketsizemin : Currency
    kf_ticketsizemax : Currency
    kf_targetyield : Decimal
    kf_esgmandatory : Boolean
    kf_status : OptionSet
    --
    createdon : DateTime
  }

  class "kf_DataRoomAccess" as DROOM {
    kf_dataroomaccessid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_contactid : Lookup → Contact
    kf_accesslevel : OptionSet
    kf_granteddate : Date
    kf_expirydate : Date
    --
    createdon : DateTime
  }
}

' ===== Commercials & Reporting =====
rectangle "Commercials & Reporting" as COMM {
  class "kf_FeeSchedule" as FEE {
    kf_feescheduleid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    feetype : OptionSet
    kf_agreedfee : Currency
    kf_feeprocentage : Decimal
    kf_billingtrigger : OptionSet
    kf_paymentterms : Integer
    --
    createdon : DateTime
  }

  class "kf_TransactionReport" as TXN {
    kf_transactionreportid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_reportdate : Date
    kf_transactionsvalue : Currency
    kf_buyeraccountid : Lookup → Account
    kf_vendoraccountid : Lookup → Account
    kf_propertyaddress : Text
    --
    createdon : DateTime
  }

  class "kf_DealProperty" as DEALPROP {
    kf_dealpropertyid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_propertyid : Lookup → kf_Property
    kf_allocationpercent : Decimal
    kf_lotstatus : OptionSet
    kf_passingrent : Currency
    kf_erv : Currency
    kf_occupancy : Decimal
    kf_wault : Decimal
    --
    createdon : DateTime
  }
}

' ===== Relationships =====
DEAL "1" --> "*" PITCH : "dealid"
DEAL "1" --> "*" NDA : "dealid"
DEAL "1" --> "*" BID : "dealid"
DEAL "1" --> "*" DD : "dealid"
DEAL "1" --> "*" REDFLAG : "dealid"
DEAL "1" --> "*" KYC : "dealid"
DEAL "1" --> "*" FEE : "dealid"
DEAL "1" --> "*" TXN : "dealid"
DEAL "1" --> "*" DEALPROP : "dealid"

BID "*" --> "1" PROFILE : "investorprofileid"
KYC "*" --> "1" ACCT : "accountid"
NDA "*" --> "1" ACCT : "accountid"
NDA "*" --> "1" CONTACT : "contactid"

' ===== Notes =====
note bottom of DEAL
  8-Stage BPF Lifecycle:
  S1 Origination (5%)
  S2 Pitch & Mandate (15%)
  S3 Instruction (25%)
  S4 Marketing (35%)
  S5 Bidding (50%)
  S6 Exclusivity (65%)
  S7 Due Diligence (85%)
  S8 Completion (100%)
  
  Regulatory gates fire
  automatically per market.
end note

note right of DEALPROP
  Junction record linking
  one deal to many assets.
  Portfolios close as one
  transaction.
end note

note bottom of PROFILE
  Investment strategy repository.
  One Brand/Group can hold
  several profiles.
end note

@enduml
