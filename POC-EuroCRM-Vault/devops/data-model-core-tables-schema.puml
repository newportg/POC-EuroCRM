@startuml EuroCRM Core Data Model

title Knight Frank EuroCRM — Core Data Model Schema

'skinparam backgroundColor #FEFEFE
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0

' ===== Client Domain =====
rectangle "Client Domain" as CLIENT {
  class "Account" as ACCT {
    accountid : GUID ++
    --
    name : Text
    accounttype : OptionSet
    kf_accountclassification : OptionSet
    kf_entitytype : OptionSet
    --
    address1_* : Composite
    telephone1 : Phone
    emailaddress1 : Email
    parentaccountid : Lookup → Account
    owningbusinessunit : Lookup → BU
  }

  class "Contact" as CONTACT {
    contactid : GUID ++
    --
    firstname : Text
    lastname : Text
    jobtitle : Text
    emailaddress1 : Email
    telephone1 : Phone
    parentcustomerid : Lookup → Account
    kf_processingconsent : OptionSet
  }

  class "kf_SICCode" as SIC {
    kf_siccodeid : GUID ++
    --
    kf_code : Text
    kf_name : Text
    kf_section : Text
    kf_kfsector : Text
  }
}

' ===== Property Domain =====
rectangle "Property Domain" as PROPERTY {
  class "kf_Site" as SITE {
    kf_siteid : GUID ++
    --
    kf_uprn : Text
    kf_cadastralref : Text
    kf_loqateid : Text
    --
    address1_* : Composite
    kf_latitude : Decimal
    kf_longitude : Decimal
  }

  class "kf_Property" as PROP {
    kf_propertyid : GUID ++
    --
    kf_sitectid : Lookup → kf_Site
    kf_name : Text
    kf_sector : OptionSet
    kf_propertytype : OptionSet
    kf_status : OptionSet
    kf_tenure : OptionSet
    --
    kf_gia : Decimal
    kf_nia : Decimal
    kf_askingprice : Currency
    kf_energyrating : OptionSet
  }

  class "kf_ResProperty" as RESPROP {
    kf_respropertyid : GUID ++
    --
    kf_sitectid : Lookup → kf_Site
    kf_name : Text
    kf_propertytype : OptionSet
    kf_tenure : OptionSet
    --
    kf_bedrooms : Integer
    kf_bathrooms : Integer
    kf_weeklyrent : Currency
    kf_guideprice : Currency
  }
}

' ===== Deal Domain =====
rectangle "Deal Domain" as DEAL {
  class "kf_Deal" as DEALREC {
    kf_dealid : GUID ++
    --
    kf_name : Text
    kf_bpfstage : OptionSet (S1-S8)
    kf_dealstatus : OptionSet
    --
    kf_accountid : Lookup → Account
    kf_contactid : Lookup → Contact
    kf_propertyid : Lookup → kf_Property
    --
    kf_grossfeevalue : Currency
    kf_netfeevalue : Currency
  }

  class "kf_DealProperty" as DEALPROP {
    kf_dealpropertyid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_propertyid : Lookup → kf_Property
    --
    kf_allocationpercent : Decimal
    kf_passingrent : Currency
    kf_erv : Currency
    kf_occupancy : Decimal
  }

  class "kf_Bid" as BID {
    kf_bidid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_investoraccountid : Lookup → Account
    --
    kf_bidround : Integer
    kf_bidamount : Currency
    kf_bidstatus : OptionSet
  }

  class "kf_NDA" as NDA {
    kf_ndaid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_accountid : Lookup → Account
    --
    kf_ndadate : Date
    kf_status : OptionSet
  }
}

' ===== Compliance Domain =====
rectangle "Compliance Domain" as COMPLY {
  class "kf_KYCRecord" as KYC {
    kf_kycrecordid : GUID ++
    --
    kf_accountid : Lookup → Account
    kf_kycstatus : OptionSet
    kf_checkdate : Date
    kf_expirydate : Date
  }

  class "kf_GDPRRequest" as GDPR {
    kf_gdprrequestid : GUID ++
    --
    kf_contactid : Lookup → Contact
    kf_requesttype : OptionSet
    kf_requestdate : Date
    kf_status : OptionSet
    kf_completiondate : Date
  }

  class "kf_EnergyRating" as ENERGY {
    kf_energyratingid : GUID ++
    --
    kf_propertyid : Lookup → kf_Property
    kfRating : OptionSet (A-G)
    kfValidFrom : Date
    kfValidTo : Date
  }
}

' ===== Supporting Domain =====
rectangle "Supporting Domain" as SUPPORT {
  class "kf_StageGateRule" as GATE {
    kf_stagegateruleid : GUID ++
    --
    kf_bpfstage : OptionSet
    kf_country : OptionSet
    kf_gatetype : OptionSet
    kf_isrequired : Boolean
    --
    statuscode : OptionSet
  }

  class "kf_IntegrationLog" as LOG {
    kf_integrationlogid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kfflowname : Text
    kfstatus : OptionSet
    kfflowrunid : GUID
    --
    kf_errormessage : Text
    createdon : DateTime
  }

  class "kf_AuditExport" as AUDIT {
    kf_auditexportid : GUID ++
    --
    kf_entityname : Text
    kf_recordid : GUID
    kf_action : OptionSet
    kf_userid : GUID
    --
    createdon : DateTime
  }
}

' ===== Relationships =====
ACCT "1" --> "*" CONTACT
ACCT "*" --> "1" SIC
ACCT "1" --> "*" DEALREC
ACCT "1" --> "*" KYC

SITE "1" --> "1" PROP
SITE "1" --> "1" RESPROP

DEALREC "1" --> "*" DEALPROP
PROP "1" --> "*" DEALPROP
DEALREC "1" --> "*" BID
DEALREC "1" --> "*" NDA
DEALREC "1" --> "*" LOG

CONTACT "1" --> "*" GDPR
PROP "1" --> "*" ENERGY

' ===== Notes =====
note bottom of ACCT
  Layer 2: KF_Core
  All table definitions are
  born here. Columns and
  relationships added by
  higher layers.
end note

note bottom of DEALREC
  8-stage BPF lifecycle.
  Stage gates fire automatically
  per market configuration.
end note

note right of GATE
  Configuration table for
  BPF stage gate validation
  rules. Country-specific
  gates defined here.
end note

@enduml
