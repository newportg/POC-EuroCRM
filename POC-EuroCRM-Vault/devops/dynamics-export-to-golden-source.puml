@startuml Dynamics Export to Golden Source
title Dynamics 365 — Direct Export to Golden Source DB

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE

package "Microsoft 365 & Dynamics Platform" as DYN #E3F2FD {
  component "Outlook\n/ Teams" as OL
  component "SharePoint" as SP
  component "Power BI" as PBI
  component "Copilot\nfor Sales" as CP

  rectangle "Dynamics 365 Sales\n+ Dataverse" as D365 {
    rectangle "Core Entities\nClient, Property,\nDeal, WIP" as ENTITIES
    rectangle "Business Process\nFlows (BPFs)" as BPF
    rectangle "Security Model\nRBAC + BU\nHierarchy" as SEC
  }
}

package "Export Mechanism" as EXPORT #FFF3E0 {
  rectangle "Scheduled\nData Export\n(Daily / Batch)" as SCHED
  rectangle "Manual\nExport\n(Ad-hoc)" as MANUAL
  rectangle "Export\nMapping &\nTransform" as MAP
}

package "Golden Source" as GS #E8F5E9 {
  database "Golden Source\nDatabase\n(PostgreSQL / SQL Server)" as DB
  rectangle "Master Data\nStore" as MDS
}

' Connections — Platform
OL -down-> D365
SP -down-> D365
CP -down-> ENTITIES
BPF -right-> ENTITIES : "Orchestrates"

' Connections — Export
D365 -down-> SCHED : "Scheduled\nExtract"
D365 -down-> MANUAL : "Manual\nExtract"
SCHED -down-> MAP
MANUAL -down-> MAP
MAP -down-> DB : "Upsert /\nFull Sync"

' Golden Source
DB -right-> MDS

note bottom of GS
  Golden Source = single authoritative
  copy of CRM entity data
  consumed by BI, Finance,
  and other downstream systems
end note

@enduml
