@startuml EuroCRM WIP Data Model

title Knight Frank EuroCRM — WIP Data Model Schema

'skinparam backgroundColor #FEFEFE
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
allowmixing 

' ===== CRM Entities =====
rectangle "CRM Entities" as CRM {
  class "kf_Deal" as DEAL {
    kf_dealid : GUID ++
    --
    kf_name : Text
    kf_dealreference : Text
    kf_bpfstage : OptionSet (S1-S8)
    kf_dealstatus : OptionSet
    --
    kf_accountid : Lookup → Account
    kf_grossfeevalue : Currency
    kf_netfeevalue : Currency
    --
    createdon : DateTime
    modifiedon : DateTime
  }

  class "kf_WIP" as WIP {
    kf_wipid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_parenttype : OptionSet
    kf_instructionid : GUID
    --
    kf_netfeetogroup : Currency
    kf_officeretained : Currency
    kf_probability : Decimal (%)
    kf_grossfee : Currency
    --
    kf_reportingmonth : Date
    kf_wipstatus : OptionSet
    kf_invoicenumber : Text
    kf_fin_localsystemref : Text
    --
    createdon : DateTime
    modifiedon : DateTime
  }

  class "kf_FeeSchedule" as FEE {
    kf_feescheduleid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    feetype : OptionSet
    kf_agreedfee : Currency
    kf_feeprocentage : Decimal
    kf_billingtrigger : OptionSet
    kf_paymentterms : Integer
    --
    createdon : DateTime
  }
}

' ===== Finance Bridge =====
rectangle "Finance Bridge (D365 Finance)" as FINANCE {
  class "Finance Project" as PROJ {
    projectid : GUID ++
    --
    projectname : Text
    projectstatus : OptionSet
    percentcomplete : Decimal
    --
    customerid : Lookup → Customer
    budgetamount : Currency
    --
    createdon : DateTime
    modifiedon : DateTime
  }

  class "Project Budget" as BUDGET {
    budgetid : GUID ++
    --
    projectid : Lookup → Finance Project
    budgettype : OptionSet
    amount : Currency
    --
    createdon : DateTime
  }

  class "Invoice Request" as INVOICE {
    invoiceid : GUID ++
    --
    projectid : Lookup → Finance Project
    invoicedate : Date
    invoiceamount : Currency
    invoicestatus : OptionSet
    --
    createdon : DateTime
  }

  class "Payment" as PAYMENT {
    paymentid : GUID ++
    --
    invoiceid : Lookup → Invoice Request
    paymentdate : Date
    paymentamount : Currency
    paymentmethod : OptionSet
    --
    createdon : DateTime
  }
}

' ===== Integration Flows =====
rectangle "Integration Flows" as FLOWS {
  collections "Flow 1: Create Project" as F1
  collections "Flow 2: Update % Complete" as F2
  collections "Flow 3: Invoice Request" as F3
  collections "Flow 4: Payment Sync" as F4
  collections "Flow 5: WIP Reconciliation" as F5
  collections "Flow 6: Credit Hold Alert" as F6
}

' ===== Relationships =====
DEAL "1" --> "0..1" WIP : "dealid"
DEAL "1" --> "*" FEE : "dealid"

WIP "1" --> "1" PROJ : "kf_fin_localsystemref"
FEE "1" --> "1" BUDGET : "projectid"
PROJ "1" --> "*" INVOICE : "projectid"
INVOICE "1" --> "*" PAYMENT : "invoiceid"

DEAL ..> F1 : "S3 triggers"
DEAL ..> F2 : "Stage change"
DEAL ..> F3 : "Deal won"
INVOICE ..> F4 : "Payment received"
WIP ..> F5 : "Monthly batch"
WIP ..> F6 : "Credit hold"

' ===== Stage Mapping =====
note as STAGE
  **8-Stage → % Complete Mapping**
  
  S1 Origination      →  5%
  S2 Pitch & Mandate  → 15%
  S3 Instruction      → 25%
  S4 Marketing        → 35%
  S5 Bidding          → 50%
  S6 Exclusivity      → 65%
  S7 Due Diligence    → 85%
  S8 Completion       → 100%
  
  BPF stage drives WIP
  calculation automatically.
end note

note bottom of WIP
  WIP = Delivered, not yet billed.
  
  kf_wipstatus options:
  • In Progress
  • Delivered
  • Billed
  • Collected
  • Written Off
end note

note bottom of PROJ
  Finance Project created at
  S3 Instruction stage.
  % complete updates on
  each stage change.
end note

STAGE -[hidden]-> PROJ

@enduml
