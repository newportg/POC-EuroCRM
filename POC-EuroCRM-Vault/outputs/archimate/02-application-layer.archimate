<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.0/archimate3_Diagram.xsd"
       identifier="id-model-eurocrm-application">

  <metadata>
    <name>EuroCRM - Application Architecture</name>
    <documentation>Application layer architecture showing Power Platform components, managed solutions, data objects, and integration services.</documentation>
  </metadata>

  <elements>
    <!-- Application Components -->
    <element identifier="id-acomp-dataverse" type="ApplicationComponent">
      <name>Dataverse</name>
      <documentation>Microsoft Dataverse - relational data store with custom tables, security framework, audit trail, and OData/Custom API access.</documentation>
    </element>
    <element identifier="id-acomp-powerapps" type="ApplicationComponent">
      <name>Power Apps Model-Driven</name>
      <documentation>Model-driven app framework providing UI, forms, views, dashboards, and mobile access.</documentation>
    </element>
    <element identifier="id-acomp-powerautomate" type="ApplicationComponent">
      <name>Power Automate</name>
      <documentation>Workflow engine for approvals, integrations, email sync, document provisioning, and marketing handoff.</documentation>
    </element>
    <element identifier="id-acomp-powerbi" type="ApplicationComponent">
      <name>Power BI</name>
      <documentation>Reporting and analytics platform. Regional, country, and service-line dashboards.</documentation>
    </element>
    <element identifier="id-acomp-kf-core" type="ApplicationComponent">
      <name>KF_Core (L2)</name>
      <documentation>Global core managed solution: 40+ table shells, option sets, BU hierarchy, base security, integration base.</documentation>
    </element>
    <element identifier="id-acomp-kf-europe" type="ApplicationComponent">
      <name>KF_Europe (L3)</name>
      <documentation>Regional layer: EUR default currency, GDPR baseline, regional Power BI dashboard, cross-border data sharing.</documentation>
    </element>
    <element identifier="id-acomp-kf-france" type="ApplicationComponent">
      <name>KF_France (L4)</name>
      <documentation>France country layer: kf_fr_* columns, CNIL compliance, notarial requirements.</documentation>
    </element>
    <element identifier="id-acomp-kf-spain" type="ApplicationComponent">
      <name>KF_Spain (L4)</name>
      <documentation>Spain country layer: kf_es_* columns, right-of-refusal rules.</documentation>
    </element>
    <element identifier="id-acomp-kf-germany" type="ApplicationComponent">
      <name>KF_Germany (L4)</name>
      <documentation>Germany country layer: kf_de_* columns, BDSG compliance.</documentation>
    </element>
    <element identifier="id-acomp-kf-poland" type="ApplicationComponent">
      <name>KF_Poland (L4)</name>
      <documentation>Poland country layer: kf_pl_* columns.</documentation>
    </element>
    <element identifier="id-acomp-kf-cm-core" type="ApplicationComponent">
      <name>KF_CapitalMarkets_Core (L5)</name>
      <documentation>Capital Markets service line: 8-stage BPF, deal lifecycle entities, pitch/NDA/bid/DD management.</documentation>
    </element>
    <element identifier="id-acomp-kf-cm-france" type="ApplicationComponent">
      <name>KF_CM_France (L6)</name>
      <documentation>France CM extension: city pre-emption, notarial process, notarial deed signing gates.</documentation>
    </element>
    <element identifier="id-acomp-kf-cm-spain" type="ApplicationComponent">
      <name>KF_CM_Spain (L6)</name>
      <documentation>Spain CM extension: right-of-refusal regulatory gate.</documentation>
    </element>
    <element identifier="id-acomp-kf-eit" type="ApplicationComponent">
      <name>KF_EIT (L7)</name>
      <documentation>Cross-border overlay: multi-jurisdiction KYC, conflict check, intercompany billing.</documentation>
    </element>
    <element identifier="id-acomp-kf-finance" type="ApplicationComponent">
      <name>KF_Finance_Integration (L5)</name>
      <documentation>Finance bridge: 9 integration flows mapping deal stage to D365 Finance % complete, WIP, invoicing.</documentation>
    </element>
    <element identifier="id-acomp-copilot" type="ApplicationComponent">
      <name>Copilot for Sales</name>
      <documentation>AI-powered client matching and intelligence.</documentation>
    </element>

    <!-- External Application Components -->
    <element identifier="id-acomp-outlook" type="ApplicationComponent">
      <name>Microsoft Outlook</name>
      <documentation>Email client with add-in for CRM activity tracking and email sync.</documentation>
    </element>
    <element identifier="id-acomp-sharepoint" type="ApplicationComponent">
      <name>SharePoint Online</name>
      <documentation>Document management: auto-provisioned deal folders, NDA storage.</documentation>
    </element>
    <element identifier="id-acomp-d365-finance" type="ApplicationComponent">
      <name>D365 Finance</name>
      <documentation>ERP system receiving 9 integration flows: project creation, % complete, invoicing, WIP, reconciliation.</documentation>
    </element>
    <element identifier="id-acomp-ci-journeys" type="ApplicationComponent">
      <name>D365 CI-Journeys</name>
      <documentation>Customer Insights - Journeys: marketing handoff, lead nurture. Same environment as Dataverse.</documentation>
    </element>
    <element identifier="id-acomp-ecs" type="ApplicationComponent">
      <name>ECS (Enterprise Connectivity Services)</name>
      <documentation>Knight Frank internal notification/message bus. Receives Major entity change events from Dataverse.</documentation>
    </element>
    <element identifier="id-acomp-loqate" type="ApplicationComponent">
      <name>Loqate</name>
      <documentation>Address validation service. Type-ahead lookup, auto-creates/matches kf_Site records.</documentation>
    </element>

    <!-- Application Services -->
    <element identifier="id-asvc-crm" type="ApplicationService">
      <name>CRM Application Service</name>
      <documentation>Unified client, property, deal management through model-driven apps.</documentation>
    </element>
    <element identifier="id-asvc-dataverse-api" type="ApplicationService">
      <name>Dataverse OData / Custom API</name>
      <documentation>Real-time data queries (OData) and triggered operations (Custom API) for external system integration.</documentation>
    </element>
    <element identifier="id-asvc-workflow" type="ApplicationService">
      <name>Workflow Automation Service</name>
      <documentation>Power Automate flows for email sync, document provisioning, marketing handoff, approvals.</documentation>
    </element>
    <element identifier="id-asvc-reporting" type="ApplicationService">
      <name>Reporting Service</name>
      <documentation>Power BI dashboards and analytics across regional, country, and service-line views.</documentation>
    </element>
    <element identifier="id-asvc-integration" type="ApplicationService">
      <name>Integration Service</name>
      <documentation>Finance bridge (9 flows), ECS change notification, Loqate address validation.</documentation>
    </element>

    <!-- Data Objects -->
    <element identifier="id-dobj-account" type="DataObject">
      <name>Account</name>
      <documentation>Organisation, brand, legal entity, fund, SPV. Two-tier hierarchy.</documentation>
    </element>
    <element identifier="id-dobj-contact" type="DataObject">
      <name>Contact</name>
      <documentation>Individual person linked to Account. GDPR consent, activity history.</documentation>
    </element>
    <element identifier="id-dobj-site" type="DataObject">
      <name>kf_Site</name>
      <documentation>Canonical physical building or land parcel. Created by Loqate auto-lookup.</documentation>
    </element>
    <element identifier="id-dobj-property" type="DataObject">
      <name>kf_Property</name>
      <documentation>Commercial asset register: sector, type, status, tenure, areas, ESG.</documentation>
    </element>
    <element identifier="id-dobj-deal" type="DataObject">
      <name>kf_Deal</name>
      <documentation>Core deal record with 8-stage BPF. Links to properties via kf_DealProperty.</documentation>
    </element>
    <element identifier="id-dobj-deal-property" type="DataObject">
      <name>kf_DealProperty</name>
      <documentation>Junction record: deal to property. Holds deal-specific measures.</documentation>
    </element>
    <element identifier="id-dobj-investor-profile" type="DataObject">
      <name>kf_InvestorProfile</name>
      <documentation>Investment strategy per Brand/Group: target sectors, geographies, ticket size.</documentation>
    </element>
    <element identifier="id-dobj-pitch" type="DataObject">
      <name>kf_Pitch</name>
      <documentation>Competitive pitch tracking for deal origination.</documentation>
    </element>
    <element identifier="id-dobj-nda" type="DataObject">
      <name>kf_NDA</name>
      <documentation>NDA counterparty management at legal entity level.</documentation>
    </element>
    <element identifier="id-dobj-bid" type="DataObject">
      <name>kf_Bid</name>
      <documentation>Multi-round bid management with investor profiles.</documentation>
    </element>
    <element identifier="id-dobj-dd-milestone" type="DataObject">
      <name>kf_DDMilestone</name>
      <documentation>Due diligence milestone tracking.</documentation>
    </element>
    <element identifier="id-dobj-red-flag" type="DataObject">
      <name>kf_RedFlag</name>
      <documentation>Risk and red flag tracking per deal.</documentation>
    </element>
    <element identifier="id-dobj-kyc" type="DataObject">
      <name>kf_KYCRecord</name>
      <documentation>KYC/AML checks at legal entity level, multi-jurisdiction.</documentation>
    </element>
    <element identifier="id-dobj-gdpr" type="DataObject">
      <name>kf_GDPRRequest</name>
      <documentation>GDPR data subject requests.</documentation>
    </element>
    <element identifier="id-dobj-fee-schedule" type="DataObject">
      <name>kf_FeeSchedule</name>
      <documentation>Fee structure per deal with billing schedule.</documentation>
    </element>
    <element identifier="id-dobj-wip" type="DataObject">
      <name>kf_WIP</name>
      <documentation>Work in progress tracking from deal creation to fee earned.</documentation>
    </element>
    <element identifier="id-dobj-txn-report" type="DataObject">
      <name>kf_TransactionReport</name>
      <documentation>Auto-generated post-close transaction reports.</documentation>
    </element>
    <element identifier="id-dobj-integration-log" type="DataObject">
      <name>kf_IntegrationLog</name>
      <documentation>Integration transaction logging for all flows.</documentation>
    </element>
    <element identifier="id-dobj-sic-code" type="DataObject">
      <name>kf_SICCode</name>
      <documentation>SIC code reference: 21 sections, 66 KF sectors.</documentation>
    </element>
    <element identifier="id-dobj-hilucs" type="DataObject">
      <name>kf_HILUCSCode</name>
      <documentation>HILUCS reference: 43 KF asset classes.</documentation>
    </element>
  </elements>

  <relationships>
    <!-- Component layering -->
    <relationship identifier="id-rel-a10" type="Flow" source="id-acomp-kf-core" target="id-acomp-dataverse"/>
    <relationship identifier="id-rel-a11" type="Flow" source="id-acomp-kf-europe" target="id-acomp-kf-core"/>
    <relationship identifier="id-rel-a12" type="Flow" source="id-acomp-kf-france" target="id-acomp-kf-europe"/>
    <relationship identifier="id-rel-a13" type="Flow" source="id-acomp-kf-spain" target="id-acomp-kf-europe"/>
    <relationship identifier="id-rel-a14" type="Flow" source="id-acomp-kf-germany" target="id-acomp-kf-europe"/>
    <relationship identifier="id-rel-a15" type="Flow" source="id-acomp-kf-poland" target="id-acomp-kf-europe"/>
    <relationship identifier="id-rel-a16" type="Flow" source="id-acomp-kf-cm-core" target="id-acomp-kf-core"/>
    <relationship identifier="id-rel-a17" type="Flow" source="id-acomp-kf-cm-france" target="id-acomp-kf-cm-core"/>
    <relationship identifier="id-rel-a18" type="Flow" source="id-acomp-kf-cm-france" target="id-acomp-kf-france"/>
    <relationship identifier="id-rel-a19" type="Flow" source="id-acomp-kf-cm-spain" target="id-acomp-kf-cm-core"/>
    <relationship identifier="id-rel-a20" type="Flow" source="id-acomp-kf-cm-spain" target="id-acomp-kf-spain"/>
    <relationship identifier="id-rel-a21" type="Flow" source="id-acomp-kf-eit" target="id-acomp-kf-europe"/>
    <relationship identifier="id-rel-a22" type="Flow" source="id-acomp-kf-eit" target="id-acomp-kf-cm-core"/>
    <relationship identifier="id-rel-a23" type="Flow" source="id-acomp-kf-finance" target="id-acomp-kf-core"/>

    <!-- App services served by components -->
    <relationship identifier="id-rel-a30" type="Serving" source="id-acomp-powerapps" target="id-asvc-crm"/>
    <relationship identifier="id-rel-a31" type="Serving" source="id-acomp-dataverse" target="id-asvc-dataverse-api"/>
    <relationship identifier="id-rel-a32" type="Serving" source="id-acomp-powerautomate" target="id-asvc-workflow"/>
    <relationship identifier="id-rel-a33" type="Serving" source="id-acomp-powerbi" target="id-asvc-reporting"/>
    <relationship identifier="id-rel-a34" type="Serving" source="id-acomp-powerautomate" target="id-asvc-integration"/>

    <!-- Services use data objects -->
    <relationship identifier="id-rel-a40" type="Access" source="id-asvc-crm" target="id-dobj-account" write="true"/>
    <relationship identifier="id-rel-a41" type="Access" source="id-asvc-crm" target="id-dobj-contact" write="true"/>
    <relationship identifier="id-rel-a42" type="Access" source="id-asvc-crm" target="id-dobj-site" write="true"/>
    <relationship identifier="id-rel-a43" type="Access" source="id-asvc-crm" target="id-dobj-property" write="true"/>
    <relationship identifier="id-rel-a44" type="Access" source="id-asvc-crm" target="id-dobj-deal" write="true"/>
    <relationship identifier="id-rel-a45" type="Access" source="id-asvc-crm" target="id-dobj-deal-property" write="true"/>
    <relationship identifier="id-rel-a46" type="Access" source="id-asvc-crm" target="id-dobj-investor-profile" write="true"/>
    <relationship identifier="id-rel-a47" type="Access" source="id-asvc-crm" target="id-dobj-pitch" write="true"/>
    <relationship identifier="id-rel-a48" type="Access" source="id-asvc-crm" target="id-dobj-nda" write="true"/>
    <relationship identifier="id-rel-a49" type="Access" source="id-asvc-crm" target="id-dobj-bid" write="true"/>
    <relationship identifier="id-rel-a50" type="Access" source="id-asvc-crm" target="id-dobj-dd-milestone" write="true"/>
    <relationship identifier="id-rel-a51" type="Access" source="id-asvc-crm" target="id-dobj-red-flag" write="true"/>
    <relationship identifier="id-rel-a52" type="Access" source="id-asvc-crm" target="id-dobj-kyc" write="true"/>
    <relationship identifier="id-rel-a53" type="Access" source="id-asvc-crm" target="id-dobj-gdpr" write="true"/>
    <relationship identifier="id-rel-a54" type="Access" source="id-asvc-crm" target="id-dobj-fee-schedule" write="true"/>
    <relationship identifier="id-rel-a55" type="Access" source="id-asvc-crm" target="id-dobj-wip" write="true"/>
    <relationship identifier="id-rel-a56" type="Access" source="id-asvc-crm" target="id-dobj-txn-report" write="true"/>

    <!-- Integration flows -->
    <relationship identifier="id-rel-a60" type="Flow" source="id-acomp-powerautomate" target="id-acomp-outlook"/>
    <relationship identifier="id-rel-a61" type="Flow" source="id-acomp-powerautomate" target="id-acomp-sharepoint"/>
    <relationship identifier="id-rel-a62" type="Flow" source="id-acomp-powerautomate" target="id-acomp-ci-journeys"/>
    <relationship identifier="id-rel-a63" type="Flow" source="id-acomp-kf-finance" target="id-acomp-d365-finance"/>
    <relationship identifier="id-rel-a64" type="Flow" source="id-acomp-loqate" target="id-acomp-dataverse"/>
    <relationship identifier="id-rel-a65" type="Flow" source="id-acomp-dataverse" target="id-acomp-ecs"/>

    <!-- Copilot -->
    <relationship identifier="id-rel-a70" type="Serving" source="id-acomp-copilot" target="id-asvc-crm"/>
  </relationships>

  <organizations>
    <item identifier="id-org-app" type="Application">
