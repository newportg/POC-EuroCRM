  <views>
    <view identifier="view-app-components" type="ApplicationComponent" viewpoint="Application Usage">
      <name>Application Component Architecture</name>
      <documentation>Power Platform components, managed solution layers, and external system integrations.</documentation>
      <!-- Platform layer -->
      <node identifier="node-ac-dataverse" elementRef="id-acomp-dataverse" x="340" y="40" w="200" h="55"/>
      <node identifier="node-ac-powerapps" elementRef="id-acomp-powerapps" x="100" y="40" w="200" h="55"/>
      <node identifier="node-ac-pa" elementRef="id-acomp-powerautomate" x="100" y="130" w="200" h="55"/>
      <node identifier="node-ac-pbi" elementRef="id-acomp-powerbi" x="580" y="40" w="200" h="55"/>
      <node identifier="node-ac-copilot" elementRef="id-acomp-copilot" x="580" y="130" w="200" h="55"/>
      <!-- Solution layers -->
      <node identifier="node-ac-l2" elementRef="id-acomp-kf-core" x="100" y="250" w="180" h="50">
        <style><fillColor color="#4472C4"/></style>
      </node>
      <node identifier="node-ac-l3" elementRef="id-acomp-kf-europe" x="320" y="250" w="180" h="50">
        <style><fillColor color="#5B9BD5"/></style>
      </node>
      <node identifier="node-ac-l5-cm" elementRef="id-acomp-kf-cm-core" x="540" y="250" w="220" h="50">
        <style><fillColor color="#ED7D31"/></style>
      </node>
      <node identifier="node-ac-l5-fin" elementRef="id-acomp-kf-finance" x="800" y="250" w="220" h="50">
        <style><fillColor color="#ED7D31"/></style>
      </node>
      <node identifier="node-ac-l4-fr" elementRef="id-acomp-kf-france" x="200" y="340" w="160" h="45">
        <style><fillColor color="#70AD47"/></style>
      </node>
      <node identifier="node-ac-l4-es" elementRef="id-acomp-kf-spain" x="400" y="340" w="160" h="45">
        <style><fillColor color="#70AD47"/></style>
      </node>
      <node identifier="node-ac-l4-de" elementRef="id-acomp-kf-germany" x="600" y="340" w="160" h="45">
        <style><fillColor color="#70AD47"/></style>
      </node>
      <node identifier="node-ac-l4-pl" elementRef="id-acomp-kf-poland" x="800" y="340" w="160" h="45">
        <style><fillColor color="#70AD47"/></style>
      </node>
      <node identifier="node-ac-l6-fr" elementRef="id-acomp-kf-cm-france" x="200" y="420" w="180" h="45">
        <style><fillColor color="#FFC000"/></style>
      </node>
      <node identifier="node-ac-l6-es" elementRef="id-acomp-kf-cm-spain" x="420" y="420" w="180" h="45">
        <style><fillColor color="#FFC000"/></style>
      </node>
      <node identifier="node-ac-l7-eit" elementRef="id-acomp-kf-eit" x="640" y="420" w="180" h="45">
        <style><fillColor color="#BF4040"/></style>
      </node>
      <!-- External -->
      <node identifier="node-ac-outlook" elementRef="id-acomp-outlook" x="60" y="530" w="160" h="45"/>
      <node identifier="node-ac-sp" elementRef="id-acomp-sharepoint" x="260" y="530" w="160" h="45"/>
      <node identifier="node-ac-d365f" elementRef="id-acomp-d365-finance" x="460" y="530" w="180" h="45"/>
      <node identifier="node-ac-cij" elementRef="id-acomp-ci-journeys" x="680" y="530" w="180" h="45"/>
      <node identifier="node-ac-loqate" elementRef="id-acomp-loqate" x="60" y="610" w="160" h="45"/>
      <node identifier="node-ac-ecs" elementRef="id-acomp-ecs" x="260" y="610" w="220" h="45"/>
      <!-- Connections -->
      <connection identifier="conn-ac1" source="node-ac-powerapps" target="node-ac-dataverse" type="Serving"/>
      <connection identifier="conn-ac2" source="node-ac-l2" target="node-ac-dataverse" type="Flow"/>
      <connection identifier="conn-ac3" source="node-ac-l3" target="node-ac-l2" type="Flow"/>
      <connection identifier="conn-ac4" source="node-ac-l4-fr" target="node-ac-l3" type="Flow"/>
      <connection identifier="conn-ac5" source="node-ac-l4-es" target="node-ac-l3" type="Flow"/>
      <connection identifier="conn-ac6" source="node-ac-l4-de" target="node-ac-l3" type="Flow"/>
      <connection identifier="conn-ac7" source="node-ac-l4-pl" target="node-ac-l3" type="Flow"/>
      <connection identifier="conn-ac8" source="node-ac-l5-cm" target="node-ac-l2" type="Flow"/>
      <connection identifier="conn-ac9" source="node-ac-l6-fr" target="node-ac-l5-cm" type="Flow"/>
      <connection identifier="conn-ac10" source="node-ac-l6-fr" target="node-ac-l4-fr" type="Flow"/>
      <connection identifier="conn-ac11" source="node-ac-l6-es" target="node-ac-l5-cm" type="Flow"/>
      <connection identifier="conn-ac12" source="node-ac-l6-es" target="node-ac-l4-es" type="Flow"/>
      <connection identifier="conn-ac13" source="node-ac-l7-eit" target="node-ac-l3" type="Flow"/>
      <connection identifier="conn-ac14" source="node-ac-l7-eit" target="node-ac-l5-cm" type="Flow"/>
      <connection identifier="conn-ac15" source="node-ac-l5-fin" target="node-ac-l2" type="Flow"/>
      <connection identifier="conn-ac16" source="node-ac-pa" target="node-ac-outlook" type="Flow"/>
