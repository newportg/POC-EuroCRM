@startuml EuroCRM Data Flow

title Knight Frank EuroCRM — Data Flow & Integrations

'skinparam backgroundColor #FEFEFE
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12

actor "Broker" as BROKER
actor "EIT Team" as EIT
actor "Finance" as FIN_USER

rectangle "Power Apps\nModel-Driven App" as APP {
  rectangle "Capital Markets\n8-Stage BPF" as CM_BPF
  rectangle "Client Management" as CLIENT_MGMT
  rectangle "Property Register" as PROP_REG
  rectangle "WIP Tracking" as WIP
}

rectangle "Dataverse" as DV {
  rectangle "Accounts\nContacts" as ACCTS
  rectangle "Properties\nSites" as PROPS
  rectangle "Deals\nBids\nNDA" as DEALS
  rectangle "WIP\nFee Schedules" as WIP_DATA
  rectangle "KYC\nGDPR" as COMPLY
}

rectangle "Integrations" as INT {
  rectangle "Power Automate" as PA
  rectangle "Finance Bridge" as FB
  rectangle "Loqate" as LOQATE
}

rectangle "External Systems" as EXT {
  rectangle "Outlook" as OL
  rectangle "SharePoint" as SP
  rectangle "Power BI" as PBI
  rectangle "D365 Finance" as D365FIN
  rectangle "CI-Journeys" as CIJ
  rectangle "Copilot" as COPILOT
}

BROKER --> APP : "Manages deals,\nclients, properties"
EIT --> APP : "Cross-border\nportfolios"
FIN_USER --> APP : "Reviews WIP,\napproves invoices"

APP --> DV : "Read/Write"
DV --> INT : "Triggers"

PA --> OL : "Email sync"
PA --> SP : "Document provisioning"
PA --> CIJ : "Marketing handoff"
FB --> D365FIN : "9 integration flows\n(Project, Budget,\nInvoice, WIP)"
LOQATE --> PROPS : "Auto-address\nvalidation"

DV --> PBI : "Dashboards"
COPILOT --> APP : "AI-powered\nmatching"

note bottom of APP
  MVP Phase 0-1:
  • Account, Contact, Property
  • Deal, DealProperty, Bid, NDA
  • FeeSchedule, KYC, InvestorProfile
  • WIP tracking with Finance bridge
end note

@enduml
