@startuml EuroCRM Layered Architecture

title Knight Frank EuroCRM — Layered Solution Model

'skinparam backgroundColor #FEFEFE
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam packageStyle rectangle

package "L7 — Cross-Border Overlays" as L7 #FFCCBC {
  rectangle "KF_EIT" as EIT
  rectangle "KF_Private_Office" as PO
}

package "L6 — Service Line + Country" as L6 #FFF9C4 {
  rectangle "KF_CM_France" as CMFR
  rectangle "KF_CM_Spain" as CMES
  rectangle "KF_OSS_France" as OSSFR
  rectangle "KF_CM_Germany" as CMDE
}

package "L5 — Service Line Core" as L5 #E0F7FA {
  rectangle "KF_CapitalMarkets_Core\n(8-Stage BPF)" as CM
  rectangle "KF_OSS_Core" as OSS
  rectangle "KF_Valuations_Core" as VAL
  rectangle "KF_Residential_Core" as RES
  rectangle "KF_Finance_Integration" as FIN
}

package "L4 — Country" as L4 #F3E5F5 {
  rectangle "KF_France\nkf_fr_*" as FR
  rectangle "KF_Germany\nkf_de_*" as DE
  rectangle "KF_Poland\nkf_pl_*" as PL
  rectangle "KF_Spain\nkf_es_*" as ES
}

package "L3 — Region" as L3 #FCE4EC {
  rectangle "KF_Europe\nEUR Default · GDPR Baseline\nRegional Power BI" as EUR
}

package "L2 — KF_Core (Global)" as L2 #FFF3E0 {
  rectangle "40+ Table Shells\nAccount · Contact · Property · Site\nDeal · DealProperty · NDA · Bid" as TABLES
  rectangle "Option Sets\nBU Hierarchy\nBase Security" as CONFIG
}

package "L1 — Dataverse Platform" as L1 #E3F2FD {
  rectangle "Microsoft-Managed\nSystem Tables · Security · Audit" as DV
}

package "L0 — External Systems" as L0 #E8F5E9 {
  rectangle "D365 CI-Journeys" as CIJ
  rectangle "D365 Finance" as FIN_EXT
  rectangle "Outlook · SharePoint\nPower BI · Copilot" as M365
  rectangle "ECS\nChange Notification Bus" as ECS_EXT
}

L0 -down-> L1
L1 -down-> L2
L2 -down-> L3
L3 -down-> L4
L4 -down-> L5
L5 -down-> L6
L6 -down-> L7

note right of L7
  Adding a country = new L4 + L6
  Adding a service line = new L5
  Each layer = separate managed solution
  No unmanaged customisations in PROD
  Major entity changes publish to ECS
end note

@enduml
