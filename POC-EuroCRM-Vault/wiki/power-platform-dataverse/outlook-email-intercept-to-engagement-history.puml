@startuml Outlook Email to CRM Engagement History
title Outlook Email Interception → CRM Engagement History

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE

package "Microsoft 365" as M365 #E3F2FD {
  component "Outlook\n(Web / Desktop / Mobile)" as OL
  component "Exchange\nOnline" as EX
  component "Microsoft Graph\nAPI" as GRAPH
}

package "Interception Paths" as INT #FFF3E0 {
  rectangle "Path A:\nOutlook Add-in\n(Compose / Read)" as ADDIN
  rectangle "Path B:\nGraph Webhook\n(Change Notification)" as WEBHOOK
  rectangle "Path C:\nMailbox Worker\n(Power Automate /\n.NET Worker)" as WORKER
}

package "Processing" as PROC #FCE4EC {
  rectangle "Correlation &\nMatching\n(To Deal / Contact)" as MATCH
  rectangle "Entity\nResolution\n(Account, Contact)" as RESOLVE
  rectangle "Deduplication &\nThread Linking" as DEDUP
}

package "CRM" as CRM #E8F5E9 {
  rectangle "Engagement History\nStore\n(Email Activity\nEntity)" as ENG
  rectangle "Linked To\nDeal / Contact /\nAccount" as LINK
}

' M365
OL -down-> EX
EX -right-> GRAPH : "Provides data"

' Interception
ADDIN -up-> OL : "Runs in context"
ADDIN -down-> WORKER
WEBHOOK -left-> GRAPH : "Subscribes\nto changes"
WEBHOOK -down-> WORKER
GRAPH -down-> WORKER

' Processing
WORKER -down-> MATCH
MATCH -down-> RESOLVE
RESOLVE -down-> DEDUP

' CRM
DEDUP -down-> ENG
ENG -down-> LINK

note bottom of INT
  Three interception options:
  A) User-triggered Outlook Add-in
  B) Automatic Graph webhook subscription
  C) Scheduled / triggered mailbox worker
end note

note right of MATCH
  Correlation keys:
  email subject / participants /
  optimised address matching
  against Deal/Contact records
end note

@enduml
