@startuml EuroCRM Property Data Model

title Knight Frank EuroCRM — Property Data Model Schema

'skinparam backgroundColor #FEFEFE
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0

' ===== Physical Asset Layer =====
rectangle "Physical Asset" as PHYSICAL {
  class "kf_Site" as SITE {
    kf_siteid : GUID ++
    --
    kf_addressline1 : Text
    kf_addressline2 : Text
    kf_city : Text
    kf_postcode : Text
    kf_country : OptionSet
    kf_latitude : Decimal
    kf_longitude : Decimal
    kf_uprn : Text (UK)
    kf_cadastralref : Text (EU)
    kf_landregistrytitle : Text
    kf_loqateid : Text
    --
    Created On : DateTime
    Modified On : DateTime
    Owner : User
  }
}

' ===== Property Records =====
rectangle "Property Records" as RECORDS {
  class "kf_Property" as PROP {
    kf_propertyid : GUID ++
    --
    kf_sitectid : Lookup → kf_Site
    kf_name : Text
    kf_addressfull : Text
    kf_sector : OptionSet
    kf_propertytype : OptionSet
    kf_status : OptionSet
    kf_tenure : OptionSet
    kf_gia : Decimal (sq m)
    kf_nia : Decimal (sq m)
    kf_floors : Integer
    kf_parking : Integer
    kf_askingprice : Currency
    kf_owneraccountid : Lookup → Account
    kf_energyrating : OptionSet
    kf_esgscore : Decimal
    --
    Created On : DateTime
    Modified On : DateTime
    Owner : User
  }

  class "kf_ResProperty" as RESPROP {
    kf_respropertyid : GUID ++
    --
    kf_sitectid : Lookup → kf_Site
    kf_name : Text
    kf_propertytype : OptionSet
    kf_tenure : OptionSet
    kf_bedrooms : Integer
    kf_bathrooms : Integer
    kf_receptions : Integer
    kf_weeklyrent : Currency
    kf_guideprice : Currency
    kf_epcrating : OptionSet
    kf_furnishing : OptionSet
    kf_counciltaxband : OptionSet
    --
    Created On : DateTime
    Modified On : DateTime
    Owner : User
  }
}

' ===== Deal Junction =====
rectangle "Deal Junction" as JUNCTION {
  class "kf_DealProperty" as DEALPROP {
    kf_dealpropertyid : GUID ++
    --
    kf_dealid : Lookup → kf_Deal
    kf_propertyid : Lookup → kf_Property
    kf_respropertyid : Lookup → kf_ResProperty
    kf_allocationpercent : Decimal
    kf_lotstatus : OptionSet
    kf_passingrent : Currency
    kf_erv : Currency
    kf_occupancy : Decimal (%)
    kf_wault : Decimal (years)
    kf_capitalvalue_psm : Currency
    kf_tenantid : Lookup → Account
    --
    Created On : DateTime
    Modified On : DateTime
    Owner : User
  }
}

' ===== Related Entities =====
rectangle "Related Entities" as RELATED {
  class "kf_EnergyRating" as ENERGY {
    kf_energyratingid : GUID ++
    --
    kfRating : OptionSet (A-G)
    kfValidFrom : Date
    kfValidTo : Date
    kf_propertyid : Lookup → kf_Property
  }

  class "kf_ESGAssessment" as ESG {
    kf_esgassessmentid : GUID ++
    --
    kfScore : Decimal
    kfAssessmentDate : Date
    kf_propertyid : Lookup → kf_Property
  }

  class "kf_ValuationInstruction" as VAL {
    kf_valuationinstructionid : GUID ++
    --
    kf_instructiondate : Date
    kf_valuationtype : OptionSet
    kf_propertyid : Lookup → kf_Property
  }

  class "kf_Lease" as LEASE {
    kf_leaseid : GUID ++
    --
    kf_leasedescription : Text
    kf_commencementdate : Date
    kf_term : Integer (years)
    kf_rent : Currency
    kf_propertyid : Lookup → kf_Property
  }
}

' ===== Relationships =====
SITE <|-- PROP : "siteid"
SITE <|-- RESPROP : "siteid"

PROP <|-- DEALPROP : "propertyid"
RESPROP <|-- DEALPROP : "respropertyid"

PROP <|-- ENERGY : "propertyid"
PROP <|-- ESG : "propertyid"
PROP <|-- VAL : "propertyid"
PROP <|-- LEASE : "propertyid"

' ===== Notes =====
note bottom of SITE
  Canonical physical building or land parcel.
  Every property record hangs off this.
  Loqate auto-creates via Power Automate.
end note

note bottom of DEALPROP
  Junction record for deal-specific measures.
  Stable characteristics on property records;
  deal-specific measures on this junction.
end note

note right of PROP
  Commercial record served by:
  • Capital Markets
  • OSS
  • Valuations
  • ESG
end note

note right of RESPROP
  Residential record served by:
  • Resi Sales & Lettings
  • Property Management
end note

@enduml
